{
  "eras": [
    {
      "id": "preqin_han",
      "name": "先秦两汉",
      "span": "前221 — 220",
      "fromYear": -221,
      "toYear": 220,
      "color": "#8b6944",
      "summary": "“南稻北麦”作物格局确立；汉代石磨普及催生蒸饼、汤饼（面条雏形）；张骞凿空西域，带回葡萄、石榴、胡麻（芝麻）、大蒜、黄瓜等“胡食”，极大丰富中原蔬果；巴蜀“尚滋味，好辛香”，以蜀椒、姜、茱萸调味。",
      "keyChanges": ["石磨推广与面食兴起", "张骞引入西域胡食", "蜀椒（花椒）成为西南核心辛香料"]
    },
    {
      "id": "weijin_nanbei",
      "name": "魏晋南北朝",
      "span": "220 — 581",
      "fromYear": 220,
      "toYear": 581,
      "color": "#5d736f",
      "summary": "草原游牧饮食与中原农耕深度交融，胡饼（烤饼）、酥酪（乳制品）、炙烤技法深入洛阳与关中；贾思勰著《齐民要术》系统总结发酵、酿造与烹饪技艺；衣冠南渡推动江南稻鱼美馔初兴。",
      "keyChanges": ["胡汉饮食融合（乳酪与烤肉）", "《齐民要术》确立中华农食体系", "江南鱼米风味觉醒"]
    },
    {
      "id": "suitang",
      "name": "隋唐盛世",
      "span": "581 — 960",
      "fromYear": 581,
      "toYear": 960,
      "color": "#b45b3e",
      "summary": "京杭大运河打通南北物产流通，长安西市汇集胡姬酒肆、胡椒与三勒浆，士大夫宴席盛行“烧尾宴”；陆羽撰《茶经》，饮茶从西南药饮蜕变为全国风雅日常。",
      "keyChanges": ["大运河贯通南北物产", "长安胡风与海丝香料输入", "陆羽《茶经》开启全民茶时代"]
    },
    {
      "id": "song_yuan",
      "name": "宋元市井",
      "span": "960 — 1368",
      "fromYear": 960,
      "toYear": 1368,
      "color": "#2f6b64",
      "summary": "北宋打破坊市宵禁，汴京夜市通宵达旦、铁锅炒菜普及，“川饭”“南食”分庭抗礼；南渡后临安成为美食之都，“苏湖熟，天下足”；元代忽思慧《饮膳正要》将蒙古烤涮与回回糖点融入中原。",
      "keyChanges": ["夜市文化与铁锅炒菜定型", "经济与风味重心南移江南", "《饮膳正要》汇通蒙回汉饮食"]
    },
    {
      "id": "ming_qing",
      "name": "明清物种大交换",
      "span": "1368 — 1912",
      "fromYear": 1368,
      "toYear": 1912,
      "color": "#b83b2b",
      "summary": "大航海引发“哥伦布大交换”：番薯、玉米、马铃薯、花生、辣椒、番茄经海路与西南边疆入华。番薯玉米养活亿万山区人口，辣椒在清代中叶彻底重塑川、湘、黔、赣菜系；运河盐商富甲天下，淮扬菜与鲁菜京化，袁枚著《随园食单》。",
      "keyChanges": ["辣椒入华并染红川湘黔赣", "番薯/玉米改变山地饮食结构", "八大菜系核心味型成熟"]
    },
    {
      "id": "modern",
      "name": "近现代百味",
      "span": "1912 — 2026",
      "fromYear": 1912,
      "toYear": 2026,
      "color": "#3d5a80",
      "summary": "铁路冷链、工业调味与跨省人口迁徙让地方小吃走向全国：沙县小吃、柳州螺蛳粉、兰州牛肉面、潮汕牛肉火锅、川渝火锅跨越地理限制，形成“一城一味、百花齐放”的当代中华风味图景。",
      "keyChanges": ["现代八大菜系与风味流派定型", "地方小吃跨省连锁化", "地理标志产品标准化保护"]
    }
  ],
